{
  "name": "shahidkhanghouri.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "prepare": "(git config --unset-all --local core.hooksPath || true) && pnpm dlx lefthook install",
